# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API（AI 問答用免費層）
GEMINI_API_KEY=your_gemini_api_key
# 主模型 / 備援模型（免費層每個模型各有獨立 RPD；主模型 429 時自動切備援）
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# AI 問答存取控制
CHAT_PASSWORD=your_chat_password          # 前端密碼閘；未設定則 /api/chat 回 503
CHAT_API_TOKEN=your_private_api_token     # 私人程式呼叫用（x-api-token），不受限流
CHAT_IP_LIMIT_PER_HOUR=10                 # 每 IP 每小時題數（預設 10）
CHAT_DAILY_LIMIT=200                      # 全站每日題數（預設 200）

# Cron Job Secret (防止未授權觸發排程)
CRON_SECRET=your_random_secret_string

# Mapbox Geocoding
MAPBOX_TOKEN=your_mapbox_token
